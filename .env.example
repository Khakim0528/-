SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./shop.db
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ADMIN_EMAIL=admin@shop.local
ADMIN_PASSWORD=admin12345

# Optional: sends real emails with the registration confirmation code.
# Leave everything below empty to just print the code to the server console (fine for local dev).

# Preferred on Render's free plan (or anywhere that blocks outbound SMTP ports):
# an HTTP API instead of SMTP. Get a free key at https://www.brevo.com (300 emails/day).
BREVO_API_KEY=
SMTP_FROM=your-verified-sender@example.com

# Plain SMTP alternative — fine for local dev, but won't work on Render's free plan.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
